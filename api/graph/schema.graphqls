"""Print/merch catalog, checkout, and fulfillment. One GraphQL surface."""
scalar Time

"""Integer money. amountCents is minor units; never a float."""
type Money {
  amountCents: Int!
  currency: String!
}

type Product {
  id: ID!
  name: String!
  description: String!
  variants: [Variant!]!
}

type Variant {
  id: ID!
  sku: String!
  size: String!
  finish: String!
  unitPrice: Money!
  """Units checkout may still take: on_hand − reserved."""
  available: Int!
}

enum OrderStatus {
  PENDING
  PAID
  PRINTING
  SHIPPED
  CANCELLED
}

type OrderLine {
  variant: Variant!
  quantity: Int!
  unitPrice: Money!
}

type Order {
  id: ID!
  status: OrderStatus!
  email: String!
  lines: [OrderLine!]!
  total: Money!
  createdAt: Time!
  updatedAt: Time!
}

type Query {
  products: [Product!]!
  product(id: ID!): Product
  order(id: ID!): Order
}

input OrderLineInput {
  variantId: ID!
  quantity: Int!
}

input CheckoutInput {
  """Caller-supplied key. Replays must send the same payload."""
  idempotencyKey: String!
  email: String!
  lines: [OrderLineInput!]!
}

type Mutation {
  """
  Reserve inventory and create an order.
  Same key + same payload returns the original order.
  Same key + different payload is an error.
  """
  checkout(input: CheckoutInput!): Order!
  markPaid(id: ID!): Order!
  startPrint(id: ID!): Order!
  markShipped(id: ID!): Order!
  cancelOrder(id: ID!): Order!
}
